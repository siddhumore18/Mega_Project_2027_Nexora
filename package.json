{
  "name": "nexora-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Nexora - Automated University Exam Timetable Scheduling, Hall Allocation & Invigilation Duty Management System",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "dev:backend": "npm run --workspace=@nexora/backend dev",
    "dev:frontend": "npm run --workspace=@nexora/frontend dev",
    "test:optimizer": "pytest optimizer/tests"
  },
  "keywords": [
    "exam-scheduling",
    "hall-allocation",
    "invigilation",
    "or-tools",
    "typescript"
  ],
  "author": "Nexora Team",
  "license": "UNLICENSED"
}
