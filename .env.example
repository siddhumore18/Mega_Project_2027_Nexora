# Application Environment
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Authentication (Placeholder - Replace in secure secret store for production)
JWT_SECRET=development_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=1h

# Database (PostgreSQL)
DATABASE_URL=postgresql://nexora_user:nexora_password@localhost:5432/nexora_db?schema=public

# Optimizer Service (Python OR-Tools)
OPTIMIZER_BASE_URL=http://localhost:5000
OPTIMIZER_SERVICE_TOKEN=dev_optimizer_secret_token

# Institution Configuration
INSTITUTION_NAME="Nexora University"
INSTITUTION_TIMEZONE="Asia/Kolkata"
